# Copy to .env and fill in. Nothing in this file is a real credential.
# Every provider below is documented in PLAN_production_rag_system.md
# under "Model providers" / "Procurement checklist" — that section
# explains why each one is here and what the free-tier limit is.

# ---------------------------------------------------------------------------
# Postgres — authoritative store for papers, chunks, ingestion state, run metadata
# ---------------------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
# A second database is created in the same instance for Airflow's own
# metadata (see infra/postgres/init-multiple-dbs.sh) — it reuses this
# user/password, database name "airflow".

# ---------------------------------------------------------------------------
# OpenSearch — hybrid lexical + dense index
# ---------------------------------------------------------------------------
# Required since OpenSearch 2.12: no default admin password. Must contain
# an uppercase letter, a lowercase letter, a digit, and a special character.
OPENSEARCH_ADMIN_PASSWORD=Change-Me-123!

# ---------------------------------------------------------------------------
# Airflow — scheduled ingestion (profile: ingestion; see README for cut order)
# ---------------------------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generate: openssl rand -hex 32
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# On Linux hosts, set to your `id -u` so mounted volumes aren't root-owned.
# No-op on Docker Desktop (Windows/Mac).
AIRFLOW_UID=50000

# ---------------------------------------------------------------------------
# Model providers — role registry binds roles to provider:model in models.yaml,
# every binding below is also overridable per-role at runtime, see bottom.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GOOGLE_AI_STUDIO_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
MISTRAL_API_KEY=
# Optional, paid, judge role only — see "Claude API" section in the plan.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings + reranking — one vendor, one key for both (A0 / A2)
# ---------------------------------------------------------------------------
JINA_API_KEY=
# Free tier is non-commercial use only (verified Aug 2026) — see the plan's
# "Commercial-use boundaries" section before any paid/public deployment.

# A2: "hosted" (default) uses the Jina reranker above. "local" uses a
# sentence-transformers cross-encoder instead — install it yourself first
# (not a default dependency, see A2), for offline runs only. Measured
# 2026-08-22 and NOT recommended as a Jina fallback on modest hardware:
# BAAI/bge-reranker-v2-m3 took ~140-165s per 20-candidate call, and even
# the tiny default model took ~10-12s — both far too slow for real use
# (see Results.md). "cohere" (added the same day) is a real, comparable-
# latency hosted alternative instead — see COHERE_API_KEY below.
RERANKER_BACKEND=hosted

# Real hosted rerank alternative to Jina (added 2026-08-22, after Jina's
# account balance ran out on 4 separate keys within about an hour).
# Verified live: correct relevance ordering, real steady-state latency
# 0.9-3.6s for 20 documents — comparable to Jina, not local-CPU-slow.
# Set RERANKER_BACKEND=cohere to use it.
COHERE_API_KEY=
RERANKER_COHERE_MODEL=rerank-v3.5

# Embed-provider switch (added 2026-08-22, src/index/embed_toggle.py) —
# "jina" (default) queries the production rag_chunks index; "mistral"
# queries the separate rag_chunks_mistral_embed index (built once via
# scripts/build_mistral_embed_index.py). A live Redis override
# (embed_toggle.set_active_embed_provider) wins over this when set. Not
# an automatic failover — a deliberate switch, since silently mixing
# vector spaces returns nonsense rankings, not an error.
EMBED_PROVIDER=jina
RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------------------
# Observability — Opik + Ragas is this project's defining eval stack.
# Instrumented with OpenTelemetry (src/platform/telemetry.py) so the code
# is vendor-neutral; these three vars are what point the OTel exporter at
# Opik Cloud specifically. Opik's self-hosted stack (MySQL+ClickHouse+
# Redis+ZooKeeper+MinIO, ~18GB recommended) doesn't fit this machine's
# Docker allocation (~3.75GB) — Cloud's free tier (25k spans/month, no
# card) is what's actually configured here, not a downgrade.
# ---------------------------------------------------------------------------
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=production-rag-system

# ---------------------------------------------------------------------------
# Paper source — arXiv needs no key, but does need a contact header.
# Ignoring this gets you rate-limited/blocked, which looks like an outage.
# ---------------------------------------------------------------------------
ARXIV_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Optional notification channel (chat delivery of answers) — omit if unused
# ---------------------------------------------------------------------------
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Per-role model overrides — env var wins over models.yaml, no code change.
# Format: provider:model  (e.g. groq:llama-3.1-8b-instant)
# Leave blank to use the ladder default from models.yaml.
# ---------------------------------------------------------------------------
RAG_MODEL_GENERATE=
RAG_MODEL_REWRITE=
RAG_MODEL_GRADE=
RAG_MODEL_JUDGE=
RAG_MODEL_EMBED=
RAG_MODEL_RERANK=

# ---------------------------------------------------------------------------
# Guardrails — "monitor" (default, evaluates+traces, never blocks) or
# "enforce" (actually blocks). citation_integrity is NOT here on purpose:
# it cannot be switched off (see the plan's guardrail-switching rules).
# ---------------------------------------------------------------------------
GUARDRAIL_SCOPE_SCREENING_MODE=monitor
GUARDRAIL_SIZE_AND_SHAPE_MODE=monitor
GUARDRAIL_GROUNDEDNESS_MODE=monitor
# Graduated to enforce 2026-08-22 after a real full 61-question A8 run
# showed a +13-point abstention-rate gain (26.09%->39.13%) with zero new
# over-refusal regressions (0.0385->0.0357, still PASS) — see Results.md.
GUARDRAIL_CONTEXT_SUFFICIENCY_MODE=enforce
GUARDRAIL_AMBIGUITY_DETECTION_MODE=monitor
# Starting point, not a verified-correct value — tune against real
# failure examples once real traffic exists.
GROUNDEDNESS_OVERLAP_THRESHOLD=0.5
